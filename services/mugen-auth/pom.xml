<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mugen</groupId>
        <artifactId>mugen-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>mugen-auth</artifactId>
    <packaging>jar</packaging>

    <name>mugen-auth</name>
    <description>Authentication: registration, login, RS256 JWT issuance, session versioning, SSO.</description>

    <dependencies>
        <!-- ============================= Web / security ============================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Google SSO (tasks.md 2.4 OAuthService, 2.7 SsoController). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!--
            Same Boot 4 modularisation as spring-boot-flyway below: RestClient lives
            in spring-web, but its autoconfiguration was split out, so without this
            there is no RestClient.Builder bean to inject at all.

            Nothing injects it since GithubProfileMapper was removed — kept for the
            device grant (tasks.md 2.12), which calls Google's endpoints directly and
            needs Boot's builder rather than RestClient.create(): the builder carries
            this service's Jackson config, including fail-on-unknown-properties=false.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>

        <!-- ============================== Persistence =============================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
            Boot 4 split autoconfiguration into one module per technology, so
            flyway-core on its own gets you the library with no autoconfiguration
            and migrations silently never run — the schema simply is not there.
            (In Boot 3 flyway-core alone was sufficient.) This module carries
            FlywayAutoConfiguration and must be present in every service that
            migrates a relational schema.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway needs the vendor module to recognise SQL Server. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-sqlserver</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================= Redis (revocation cache) ======================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ================================= Kafka ==================================
             The same Boot 4 modularisation as spring-boot-flyway and
             spring-boot-restclient above, and it bites hardest here: spring-kafka
             gives you KafkaTemplate the class, but KafkaAutoConfiguration — the
             thing that turns spring.kafka.* into an actual KafkaTemplate bean —
             ships separately in spring-boot-kafka. Without it the context fails at
             startup on OutboxPoller's missing KafkaTemplate.

             Every test missed this: OutboxPollerTest mocks the template, and the
             integration tests set mugen.outbox.enabled=false because they have no
             broker, so nothing ever asked the context for the real bean. It
             surfaced on the first actual run. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ============================== Discovery ================================= -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- ================================== JWT ===================================
             Spring Security's own JOSE support (Nimbus underneath) rather than a
             standalone JWT library. It provides JwtEncoder for signing here, and
             the same artifact gives mugen-gateway a one-line JwtDecoder — so sign
             and verify share one implementation and one set of validation rules
             instead of two libraries that must be kept agreeing with each other.
             It also makes /me and /validate a plain resource server rather than a
             hand-written verification filter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ============================== API docs ==================================
             springdoc 3.x, the Boot 4 line — 2.x targets Boot 3 / Framework 6 and
             does not resolve here. Version comes from the BOM in the root pom.

             The `-ui` starter rather than the `-api` one: it adds the Swagger UI
             webjar on top, which is the point of the task. Whether it is served at
             all is a property (springdoc.swagger-ui.enabled), so the deploy profile
             can switch the UI off without changing the dependency set — see
             application-docker.yml. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Reads back what the root pom's therapi processor recorded, so springdoc
             can use a method's javadoc as its description. springdoc treats this as
             optional and falls back silently when it is absent, which is why
             OpenApiIntegrationTest asserts a javadoc string reaches the document. -->
        <dependency>
            <groupId>com.github.therapi</groupId>
            <artifactId>therapi-runtime-javadoc</artifactId>
            <version>${therapi.version}</version>
        </dependency>

        <!-- ============================ Shared contracts ============================ -->
        <dependency>
            <groupId>com.mugen</groupId>
            <artifactId>mugen-shared</artifactId>
        </dependency>
        <!-- Brings the AppException hierarchy and auto-registers the RFC 9457 handler. -->
        <dependency>
            <groupId>com.mugen</groupId>
            <artifactId>mugen-web</artifactId>
        </dependency>

        <!-- ============================= Observability ============================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Without this /actuator/prometheus does not exist and the scrape 404s. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Bridges Micrometer's Observation API onto OpenTelemetry, and exports
             OTLP to Jaeger. This is also what populates the traceId MDC key that
             TraceIdHolder and the ProblemDetail handler read. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ================================= Test =================================== -->
        <!--
            The three tiers and everything they need: JUnit, AssertJ, Mockito,
            spring-test, spring-security-test, the @WebMvcTest slice module and
            Testcontainers' JUnit integration all arrive through this one dependency.
        -->
        <dependency>
            <groupId>com.mugen</groupId>
            <artifactId>mugen-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The container image is the service's own business — mugen-auth is SQL
            Server, mugen-user will be Postgres — so it stays here rather than in
            mugen-test. See AuthContainers.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mssqlserver</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
