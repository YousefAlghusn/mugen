<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mugen</groupId>
        <artifactId>mugen-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>mugen-shared</artifactId>
    <packaging>jar</packaging>

    <name>mugen-shared</name>
    <description>Shared Kafka event contracts, API response envelope, and cross-service utilities.</description>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Instant (de)serialization for the event contracts' occurredAt. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--
            Plain JUnit + AssertJ rather than spring-boot-starter-test: this
            module has no Spring context, and pulling the full starter in would
            let a Spring dependency leak into what is meant to be a pure
            contract jar shared by all 11 services.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test scope only. A library must never ship an SLF4J binding — that is
            the consuming application's choice — but without a provider on the
            classpath MDC silently degrades to a no-op adapter, so TraceIdHolder
            would appear to work while storing nothing. Services get logback via
            spring-boot-starter-logging; the tests need it explicitly.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
