# Mugen local environment variables.
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
#
# ===================================================================
# READ THIS FIRST — two audiences, two hostnames
# ===================================================================
# Docker Compose reads this file automatically. Spring Boot does NOT.
#
# SECTION A vars are substituted into compose.yml and are read by containers,
#   so they use Docker network hostnames (sqlserver, minio, kafka).
#
# SECTION B vars are for the application services, which run on the HOST
#   (`mvn spring-boot:run`), not in Docker. They therefore use localhost and
#   the published port. Spring only sees them if they are exported into the
#   service's environment — via the IntelliJ EnvFile plugin, a run
#   configuration, or `export`. application-docker.yml reads them with
#   `${VAR:sane-default}` so a plain `mvn spring-boot:run` still works.
#
# The distinction is not cosmetic: kafka:29092 is unreachable from the host,
# and localhost:9092 is unreachable from inside a container.


# ###################################################################
# SECTION A — Docker Compose / container-side
# ###################################################################

# ===================================================================
# SQL Server — mugen-auth
# ===================================================================
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DB=mugen_auth
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=ChangeMe_Str0ng!
SQLSERVER_ACCEPT_EULA=Y

# ===================================================================
# Postgres — mugen-user, mugen-payment
# ===================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER_DB=mugen_user
POSTGRES_PAYMENT_DB=mugen_payment
POSTGRES_USER=mugen
POSTGRES_PASSWORD=ChangeMe_Str0ng!

# ===================================================================
# MongoDB — mugen-post, mugen-video, mugen-feed, mugen-notification
# ===================================================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=mugen
MONGO_INITDB_ROOT_PASSWORD=ChangeMe_Str0ng!
MONGO_POST_DB=mugen_post
MONGO_VIDEO_DB=mugen_video
MONGO_FEED_DB=mugen_feed
MONGO_NOTIFICATION_DB=mugen_notification

# ===================================================================
# Redis — cache, sessions, rate limiting, revocation cache
# ===================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================================================================
# Kafka — KRaft mode, no ZooKeeper (removed in Kafka 4.0, KIP-500)
# ===================================================================
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_NODE_ID=1
# Base64 22-char cluster UUID. Written into the kafka-data volume on first
# start; changing it afterwards requires `docker compose down -v`.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ===================================================================
# MinIO — object storage
# ===================================================================
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=mugen
MINIO_ROOT_PASSWORD=ChangeMe_Str0ng!
# Container-side endpoint, used by the minio-init bucket bootstrapper.
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_AVATARS=mugen-avatars
MINIO_BUCKET_RAW=mugen-raw
MINIO_BUCKET_HLS=mugen-hls
MINIO_BUCKET_MEDIA=mugen-media

# ===================================================================
# Elasticsearch — mugen-search
# ===================================================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ===================================================================
# Eureka — service discovery
# ===================================================================
EUREKA_HOST=eureka
EUREKA_PORT=8761

# ===================================================================
# Observability — Jaeger, Prometheus, Grafana, Loki
# ===================================================================
JAEGER_HOST=jaeger
JAEGER_OTLP_GRPC_PORT=4317
# Spring Boot's OTLP tracing exporter speaks HTTP, not gRPC — 4318 is the
# port the services actually use.
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_Str0ng!
LOKI_HOST=loki
LOKI_PORT=3100


# ###################################################################
# SECTION B — host-run Spring services
# Hostnames are localhost here, deliberately. See the header.
# ###################################################################

# ===================================================================
# Infra endpoints as seen from the host
# ===================================================================
MUGEN_SQLSERVER_URL=jdbc:sqlserver://localhost:1433;databaseName=mugen_auth;encrypt=true;trustServerCertificate=true
MUGEN_SQLSERVER_USER=sa
MUGEN_SQLSERVER_PASSWORD=ChangeMe_Str0ng!
MUGEN_POSTGRES_USER_URL=jdbc:postgresql://localhost:5432/mugen_user
MUGEN_POSTGRES_PAYMENT_URL=jdbc:postgresql://localhost:5432/mugen_payment
MUGEN_MONGO_URI=mongodb://mugen:ChangeMe_Str0ng!@localhost:27017
MUGEN_REDIS_HOST=localhost
MUGEN_REDIS_PORT=6379
# EXTERNAL listener. kafka:29092 is the INTERNAL one and is container-only.
MUGEN_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MUGEN_MINIO_ENDPOINT=http://localhost:9000
MUGEN_ELASTICSEARCH_URI=http://localhost:9200
MUGEN_EUREKA_URI=http://localhost:8761/eureka
MUGEN_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
MUGEN_LOKI_URL=http://localhost:3100/loki/api/v1/push

# ===================================================================
# Service ports (scraped by the dockerized Prometheus via
# host.docker.internal — see config/prometheus/prometheus.yml)
# ===================================================================
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
POST_SERVICE_PORT=8083
FEED_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
PAYMENT_SERVICE_PORT=8086
VIDEO_SERVICE_PORT=8087
TRANSCODE_SERVICE_PORT=8088
SEARCH_SERVICE_PORT=8089

# ===================================================================
# JWT — mugen-auth signs, mugen-gateway verifies
# ===================================================================
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_REVOCATION_CACHE_TTL_MINUTES=15

# ===================================================================
# MinIO presigned URL policy — URL valid 60 min, cached 50 min so a
# cached URL can never be handed out after it has expired.
# ===================================================================
MINIO_PRESIGNED_URL_TTL_MINUTES=60
MINIO_PRESIGNED_URL_CACHE_TTL_MINUTES=50

# ===================================================================
# OAuth / SSO providers — mugen-auth
# ===================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ===================================================================
# FFmpeg — mugen-transcode
# ===================================================================
FFMPEG_BINARY_PATH=/usr/bin/ffmpeg
