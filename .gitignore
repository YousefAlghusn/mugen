.logs

# --- Secrets / keys ---
.env
.env.*
!.env.example
# Only the RSA private key is secret — public.pem is committed and copied
# from mugen-auth into mugen-gateway's resources (see tasks.md 3.1).
**/keys/private.pem

# --- HTTP client private env (tokens/creds) ---
http/http-client.private.env.json
http-client.private.env.json

# --- Docker volumes / local data ---
docker-data/
