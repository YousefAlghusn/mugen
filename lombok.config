# Root of the Lombok config tree — stops Lombok searching parent directories.
config.stopBubbling = true

# Marks generated members with @lombok.Generated so coverage tools do not report
# generated getters as untested branches.
lombok.addLombokGeneratedAnnotation = true

# Forbid the annotations that are actively wrong on JPA entities, which is most of
# what this project models:
#   @Data      bundles @EqualsAndHashCode and @ToString, both broken below.
#   @Value     makes the class final — Hibernate cannot proxy it for lazy loading.
#   @EqualsAndHashCode  derives identity from mutable fields, so an entity changes
#                       hash once persisted and is lost inside any HashSet it is in.
#   @ToString  walks lazy associations and triggers loading, or throws
#              LazyInitializationException outside a session.
# BaseEntity implements equals/hashCode/toString correctly and marks them final.
lombok.data.flagUsage = ERROR
lombok.value.flagUsage = ERROR
lombok.equalsAndHashCode.flagUsage = ERROR
lombok.toString.flagUsage = ERROR
