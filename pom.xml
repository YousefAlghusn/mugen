<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.mugen</groupId>
    <artifactId>mugen-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>mugen-parent</name>
    <description>Mugen - infinite content, infinite community. Root aggregator module.</description>

    <!--
        Modules are declared as they are created (see docs/dev/tasks.md). Declaring a
        module whose pom.xml does not exist yet breaks every Maven command at the root,
        so a service is added here in the same commit that creates it.
    -->
    <modules>
        <module>shared/mugen-shared</module>
        <module>shared/mugen-web</module>
        <module>shared/mugen-test</module>
        <module>services/mugen-auth</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <minimum-maven.version>3.9.0</minimum-maven.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <!--
            springdoc 3.x is the Boot 4 line; 2.x targets Boot 3 / Framework 6 and
            will not work here. 3.1.0 is built against spring-boot-starter-parent
            4.1.0 — the same version this pom inherits — so its Spring dependencies
            are managed to exactly what the rest of the build already resolves.
        -->
        <springdoc.version>3.1.0</springdoc.version>
        <!--
            Lets springdoc read javadoc, so an endpoint is documented once instead of
            twice. Version is ours because springdoc's BOM manages only its own
            artifacts, and an annotationProcessorPath needs a literal version anyway.
        -->
        <therapi.version>0.15.0</therapi.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                The Boot 4.1 BOM manages spring-boot-testcontainers but not the
                org.testcontainers modules themselves, so their BOM is imported
                here to keep every service's container versions aligned.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Boot's BOM does not manage springdoc, so without this every service
                would repeat the version and they would drift. Imported rather than
                pinned per dependency because the ui starter, the api starter and
                the swagger-core artifacts underneath it all have to agree.
            -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Managed here so services depend on mugen-shared without repeating the version. -->
            <dependency>
                <groupId>com.mugen</groupId>
                <artifactId>mugen-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mugen</groupId>
                <artifactId>mugen-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mugen</groupId>
                <artifactId>mugen-test</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Inherited by every module. optional=true keeps Lombok off the runtime
        classpath and out of downstream consumers' dependency graphs — it is a
        compile-time annotation processor, nothing more.
    -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <!--
                            Writes META-INF/build-info.properties, which Boot exposes as
                            BuildProperties. The OpenAPI document reads its version from
                            there, so no service maintains a version literal that goes
                            stale silently. Managed here so all eleven inherit it.
                        -->
                        <execution>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                therapi's processor records javadoc into the jar, which is where
                springdoc reads endpoint descriptions from.

                Lombok is listed here because it has to be: declaring
                annotationProcessorPaths turns off processor discovery from the
                compile classpath, which is how Lombok ran until now. Omit it and
                every @RequiredArgsConstructor silently stops generating.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>com.github.therapi</groupId>
                            <artifactId>therapi-runtime-javadoc-scribe</artifactId>
                            <version>${therapi.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Fail fast and loudly if the toolchain is not what every module assumes. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${minimum-maven.version},)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                The tier a test lives in is its directory, and that directory decides
                which runner gets it. See shared/mugen-test's package-info for what the
                three tiers mean and how to pick one.

                Path-based rather than by class-name suffix so the two cannot disagree:
                a file under integration/ cannot be handed to surefire by forgetting to
                rename it. `mvn test` runs unit and slice — fast, no Docker. `mvn verify`
                adds integration, which needs a Docker daemon for Testcontainers.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/unit/**/*Test.java</include>
                        <include>**/slice/**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/integration/**/*Test.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
